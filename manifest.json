{
  "manifest_version": 3,
  "name": "Snapfire – Full Page Screenshot",
  "version": "1.0.0",
  "description": "Screenshot the whole page in one click: no scrolling seams, no account, no upsell. Save as PNG or JPEG, or copy it. Nothing leaves your browser.",
  "homepage_url": "https://github.com/prometheus-maker/snapfire",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Screenshot this page",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "commands": {
    "capture-full": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Screenshot the whole page" }
  },
  "permissions": ["activeTab", "scripting"],
  "background": { "scripts": ["src/background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "snapfire@prometheus-maker.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
